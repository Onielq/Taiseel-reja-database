# Local development only. Replace credentials and use a secret manager in deployment.
DATABASE_URL=postgres://reja:reja_local_dev_change_this@127.0.0.1:5432/reja
# Optional read-only credentials for the runtime web server; migrations/import still use DATABASE_URL.
# APP_DATABASE_URL=postgres://reja_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/reja
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# Optional server-side path to a different REJA HTML export for re-importing.
REJA_HTML_PATH=./public/REJA-standalone.html
